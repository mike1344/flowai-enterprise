# 复制为 .env 后填写真实值；.env 不入版本库（docs/08 §2）
# 仅变量名与占位值，禁止提交真实密钥

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

FLOWAI_DB_NAME=flowai_db
FLOWAI_DB_USER=flowai_app
FLOWAI_DB_PASSWORD=CHANGE_ME_FLOWAI_DB_PASSWORD

INDUSTRIAL_DB_NAME=industrial_db
INDUSTRIAL_DB_USER=industrial_app
INDUSTRIAL_DB_PASSWORD=CHANGE_ME_INDUSTRIAL_DB_PASSWORD

# 跨服务身份（ADR-008）：FlowAI 与 Industrial 共用同一签名密钥
SERVICE_JWT_SECRET=CHANGE_ME_32_BYTES_RANDOM
SERVICE_JWT_KID=k1

# 会话与 CSRF（ADR-013）
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
CSRF_SECRET=CHANGE_ME_CSRF_SECRET

# 对外入口与开关
PUBLIC_BASE_URL=http://127.0.0.1:8080
FRONTEND_PORT=8080
LOG_LEVEL=INFO
ENABLE_ADMIN_WRITE_API=false