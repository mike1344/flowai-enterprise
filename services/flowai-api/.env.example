# FlowAI API 配置示例：只含变量名与安全占位值，真实 .env 不入库（docs/08 §2）
FLOWAI_ENVIRONMENT=local
FLOWAI_LOG_LEVEL=INFO
FLOWAI_TRACE_HEADER=X-Trace-ID
FLOWAI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 数据库（M00-03 起启用；纯 Python 驱动 PyMySQL）
FLOWAI_DATABASE_URL=mysql+pymysql://flowai_app:CHANGE_ME@127.0.0.1:3306/flowai_db?charset=utf8mb4
FLOWAI_REDIS_URL=redis://127.0.0.1:6379/0
FLOWAI_CHROMA_URL=http://127.0.0.1:8000

# 跨服务身份（ADR-008）
FLOWAI_SERVICE_JWT_SECRET=CHANGE_ME_32_BYTES_RANDOM
FLOWAI_SERVICE_JWT_KID=k1
FLOWAI_SERVICE_JWT_ISSUER=flowai-api
FLOWAI_SERVICE_JWT_AUDIENCE=industrial-api

# 会话与 Web 安全（ADR-013）
FLOWAI_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
FLOWAI_CSRF_SECRET=CHANGE_ME_CSRF_SECRET
FLOWAI_SESSION_TTL_MINUTES=60
FLOWAI_UPLOAD_MAX_MB=20
FLOWAI_LOG_RETENTION_DAYS=30
FLOWAI_PUBLIC_BASE_URL=http://127.0.0.1:8080

# 模型与向量（M02-02 / M03-02）
FLOWAI_LLM_PROVIDER=openai-compatible
FLOWAI_LLM_BASE_URL=
FLOWAI_LLM_API_KEY=
FLOWAI_LLM_MODEL=
FLOWAI_EMBEDDING_PROVIDER=openai-compatible
FLOWAI_EMBEDDING_MODEL=
FLOWAI_EMBEDDING_API_KEY=