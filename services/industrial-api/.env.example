# Industrial API 配置示例：只含变量名与安全占位值，真实 .env 不入库
INDUSTRIAL_ENVIRONMENT=local
INDUSTRIAL_LOG_LEVEL=INFO
INDUSTRIAL_TRACE_HEADER=X-Trace-ID
INDUSTRIAL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 独立业务库（独立账号，禁止与 flowai_db 共用）
INDUSTRIAL_DATABASE_URL=mysql+pymysql://industrial_app:CHANGE_ME@127.0.0.1:3306/industrial_db?charset=utf8mb4
INDUSTRIAL_REDIS_URL=redis://127.0.0.1:6379/1

# 跨服务身份校验（ADR-008，密钥与 FlowAI 侧一致）
INDUSTRIAL_SERVICE_JWT_SECRET=CHANGE_ME_32_BYTES_RANDOM
INDUSTRIAL_SERVICE_JWT_KID=k1
INDUSTRIAL_SERVICE_JWT_ISSUER=flowai-api
INDUSTRIAL_SERVICE_JWT_AUDIENCE=industrial-api

# 受控管理写 API（ADR-011，默认关闭）
INDUSTRIAL_ENABLE_ADMIN_WRITE_API=false
INDUSTRIAL_LOG_RETENTION_DAYS=30